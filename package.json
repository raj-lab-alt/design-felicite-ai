{
  "name": "design-felicite-ai",
  "productName": "Design Félicité AI",
  "version": "0.1.1",
  "description": "Application professionnelle d'analyse et d'optimisation des designs commerciaux (analyse visuelle multimodale Gemini, scoring heuristique, propositions de redesign).",
  "author": "Design Félicité AI",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/raj-lab-alt/design-felicite-ai.git"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:ci": "electron-vite build && electron-builder --win --publish never",
    "dist:publish": "electron-vite build && electron-builder --win --publish always",
    "release:check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "release:patch": "npm run release:check && npm version patch",
    "postinstall": "node scripts/patch-electronrc.mjs"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.54.0",
    "node-sqlite3-wasm": "^0.8.60",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
